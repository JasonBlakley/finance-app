{
  "name": "finance-app",
  "version": "0.1.0",
  "description": "IBM Bob Workshop - Finance Dashboard Application",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n ui,api \"npm:dev\" \"npm:dev:server\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@carbon/charts": "^1.27.27",
    "@carbon/charts-react": "^1.27.27",
    "@carbon/react": "^1.121.0",
    "@ibm/plex": "^6.4.1",
    "@tanstack/react-query": "^5.108.4",
    "cors": "^2.8.6",
    "d3": "^7.9.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "yahoo-finance2": "^4.0.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "msw": "^3.0.7",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
